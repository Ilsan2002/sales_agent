# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# Apollo.io API key — create one in Apollo under Settings > Integrations > API.
# Used by the Apollo MCP server; sent as the X-Api-Key header.
APOLLO_API_KEY=

# Anthropic API key — used by the sales agent (agent/sales_agent.py).
# Alternatively authenticate with `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
